# Copy to .env.local, never commit the populated copy.
# This optional read-only F4 identity check does NOT enable live finance.
VITE_FM_ENABLE_IDENTITY_CHECK=false
# Separate, opt-in connected READ-ONLY route: ?mode=live
VITE_FM_ENABLE_LIVE_READ=false
VITE_FM_ENTRA_CLIENT_ID=YOUR_ENTRA_APPLICATION_CLIENT_GUID
VITE_FM_ENTRA_TENANT_ID=YOUR_ENTRA_DIRECTORY_TENANT_GUID
VITE_FM_ORGANIZATION_URL=https://YOURORG.crm3.dynamics.com/
VITE_FM_ORGANIZATION_ID=YOUR_DATAVERSE_ORGANIZATION_GUID
