table FactPostedExpense

	measure 'Paid Spending' = SUM ( FactPostedExpense[AmountPEN] )
		formatString: #,##0.00

	measure 'Payment Count' = COUNTROWS ( FactPostedExpense )
		formatString: #,##0

	measure 'Average Payment' = DIVIDE ( [Paid Spending], [Payment Count] )
		formatString: #,##0.00

	measure 'Operating Spending' = CALCULATE ( [Paid Spending], FactPostedExpense[FlowClassCode] = 797280000 )
		formatString: #,##0.00

	measure 'Capital Spending' = CALCULATE ( [Paid Spending], FactPostedExpense[FlowClassCode] = 797280001 )
		formatString: #,##0.00

	measure 'Tax Spending' = CALCULATE ( [Paid Spending], FactPostedExpense[FlowClassCode] = 797280002 )
		formatString: #,##0.00

	measure 'Other Spending' = CALCULATE ( [Paid Spending], FactPostedExpense[FlowClassCode] = 797280003 )
		formatString: #,##0.00

	measure 'Shared Spending' = CALCULATE ( [Paid Spending], FactPostedExpense[ScopeCode] = 797280001 )
		formatString: #,##0.00

	measure 'Branch Spending' = CALCULATE ( [Paid Spending], FactPostedExpense[ScopeCode] = 797280000 )
		formatString: #,##0.00

	measure 'Prior Year Spending' = CALCULATE ( [Paid Spending], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: #,##0.00

	measure 'Year-over-Year Change' = IF ( ISBLANK ( [Prior Year Spending] ), BLANK (), [Paid Spending] - [Prior Year Spending] )
		formatString: #,##0.00

	measure 'Year-over-Year Change %' = IF ( NOT HASONEVALUE ( DimDate[Year] ), BLANK (), DIVIDE ( [Year-over-Year Change], [Prior Year Spending] ) )
		formatString: 0.0%

	measure 'Pagos confirmados KPI' = COALESCE ( [Paid Spending], 0 )
		formatString: "S/ "#,##0.00

	measure 'Cantidad de pagos KPI' = COALESCE ( [Payment Count], 0 )
		formatString: #,##0

	measure 'Ticket promedio KPI' = COALESCE ( [Average Payment], 0 )
		formatString: "S/ "#,##0.00

	measure 'Gasto compartido KPI' = COALESCE ( [Shared Spending], 0 )
		formatString: "S/ "#,##0.00

	measure 'Gasto por sede KPI' = COALESCE ( [Branch Spending], 0 )
		formatString: "S/ "#,##0.00

	measure 'Gasto anterior KPI' = IF ( NOT HASONEVALUE ( DimDate[Year] ), "Selecciona un año", IF ( ISBLANK ( [Prior Year Spending] ), "Sin base anterior", "S/ " & FORMAT ( [Prior Year Spending], "#,##0.00" ) ) )

	measure 'Participación compartida' = COALESCE ( DIVIDE ( [Shared Spending], [Paid Spending], 0 ), 0 )
		formatString: 0.0%

	measure 'Participación categoría' = COALESCE ( DIVIDE ( [Paid Spending], CALCULATE ( [Paid Spending], ALLSELECTED ( DimCategory ) ), 0 ), 0 )
		formatString: 0.0%

	measure 'Categorías con pagos' = COALESCE ( DISTINCTCOUNT ( FactPostedExpense[CategoryId] ), 0 )
		formatString: #,##0

	measure 'Gasto acumulado YTD' = VAR LastPaidDate = MAX ( FactPostedExpense[TransactionDate] ) RETURN IF ( ISBLANK ( LastPaidDate ), 0, COALESCE ( CALCULATE ( [Paid Spending], DATESBETWEEN ( DimDate[Date], DATE ( YEAR ( LastPaidDate ), 1, 1 ), LastPaidDate ) ), 0 ) )
		formatString: "S/ "#,##0.00

	measure 'Meses con pagos' = COALESCE ( COUNTROWS ( FILTER ( VALUES ( DimDate[YearMonth] ), NOT ISBLANK ( [Paid Spending] ) ) ), 0 )
		formatString: #,##0

	measure 'Promedio mensual pagado' = COALESCE ( DIVIDE ( [Paid Spending], [Meses con pagos], 0 ), 0 )
		formatString: "S/ "#,##0.00

	measure 'Variación interanual lectura' = IF ( NOT HASONEVALUE ( DimDate[Year] ), "Selecciona un año", IF ( ISBLANK ( [Prior Year Spending] ) || [Prior Year Spending] = 0, "Sin base anterior", FORMAT ( [Year-over-Year Change %], "0.0%;-0.0%;0.0%" ) ) )

	measure 'Estado del informe' = IF ( [Payment Count] = 0 || ISBLANK ( [Payment Count] ), "Sin pagos confirmados en PEN para los filtros actuales", "Pagos contabilizados · fuente Dataverse" )

	column FlowClassLabel
		dataType: string
		sourceColumn: FlowClassLabel
		summarizeBy: none

	column ScopeLabel
		dataType: string
		sourceColumn: ScopeLabel
		summarizeBy: none

	column ExpenseId
		dataType: string
		isHidden
		sourceColumn: ExpenseId
		summarizeBy: none

	column ExpenseReference
		dataType: string
		sourceColumn: ExpenseReference
		summarizeBy: none

	column TransactionDate
		dataType: dateTime
		sourceColumn: TransactionDate
		summarizeBy: none

	column AmountPEN
		dataType: decimal
		sourceColumn: AmountPEN
		summarizeBy: none

	column StatusCode
		dataType: int64
		isHidden
		sourceColumn: StatusCode
		summarizeBy: none

	column FlowClassCode
		dataType: int64
		sourceColumn: FlowClassCode
		summarizeBy: none

	column ScopeCode
		dataType: int64
		sourceColumn: ScopeCode
		summarizeBy: none

	column BranchId
		dataType: string
		isHidden
		sourceColumn: BranchId
		summarizeBy: none

	column CategoryId
		dataType: string
		isHidden
		sourceColumn: CategoryId
		summarizeBy: none

	column CashAccountId
		dataType: string
		isHidden
		sourceColumn: CashAccountId
		summarizeBy: none

	column CurrencyId
		dataType: string
		isHidden
		sourceColumn: CurrencyId
		summarizeBy: none

	partition FactPostedExpense = m
		mode: import
		source =
			let
			    Source = CommonDataService.Database(
			        DataverseHost,
			        [CreateNavigationProperties = false]
			    ),
			    PostedRows = Value.NativeQuery(
			        Source,
			        "
			        SELECT
			            fmg_financialtransactionid,
			            fmg_name,
			            fmg_transactiondate,
			            fmg_amount,
			            fmg_status,
			            fmg_flowclass,
			            fmg_scope,
			            fmg_branch,
			            fmg_category,
			            fmg_cashaccount,
			            expense.transactioncurrencyid
			        FROM fmg_financialtransaction AS expense
			        INNER JOIN transactioncurrency AS currency
			            ON expense.transactioncurrencyid = currency.transactioncurrencyid
			        WHERE expense.fmg_status = 797280001
			          AND currency.isocurrencycode = 'PEN'
			        ",
			        null,
			        [EnableFolding = true]
			    ),
			    NamedColumns = Table.RenameColumns(
			        PostedRows,
			        {
			            {"fmg_financialtransactionid", "ExpenseId"},
			            {"fmg_name", "ExpenseReference"},
			            {"fmg_transactiondate", "TransactionDate"},
			            {"fmg_amount", "AmountPEN"},
			            {"fmg_status", "StatusCode"},
			            {"fmg_flowclass", "FlowClassCode"},
			            {"fmg_scope", "ScopeCode"},
			            {"fmg_branch", "BranchId"},
			            {"fmg_category", "CategoryId"},
			            {"fmg_cashaccount", "CashAccountId"},
			            {"transactioncurrencyid", "CurrencyId"}
			        }
			    ),
			    KeysAsText = Table.TransformColumns(
			        NamedColumns,
			        {
			            {"ExpenseId", each if _ = null then null else Text.Lower(Text.From(_)), type text},
			            {"BranchId", each if _ = null then null else Text.Lower(Text.From(_)), type text},
			            {"CategoryId", each if _ = null then null else Text.Lower(Text.From(_)), type text},
			            {"CashAccountId", each if _ = null then null else Text.Lower(Text.From(_)), type text},
			            {"CurrencyId", each if _ = null then null else Text.Lower(Text.From(_)), type text}
			        }
			    ),
			    Typed = Table.TransformColumnTypes(
			        KeysAsText,
			        {
			            {"ExpenseReference", type text},
			            {"TransactionDate", type date},
			            {"AmountPEN", Currency.Type},
			            {"StatusCode", Int64.Type},
			            {"FlowClassCode", Int64.Type},
			            {"ScopeCode", Int64.Type}
			        }
			    )
            , FlowLabels = Table.AddColumn(Typed, "FlowClassLabel", each if [FlowClassCode] = 797280000 then "Operativo" else if [FlowClassCode] = 797280001 then "Capital" else if [FlowClassCode] = 797280002 then "Impuestos" else "Otros", type text)
            , ScopeLabels = Table.AddColumn(FlowLabels, "ScopeLabel", each if [ScopeCode] = 797280001 then "Compartido" else "Por sede", type text)
			in
			    ScopeLabels