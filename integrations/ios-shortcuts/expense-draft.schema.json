{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FM-11: solicitud de borrador de gasto (sin autorización de escritura)",
  "description": "Validación de formato para la bandeja de revisión Power Automate; no sustituye verificación de remitente, aprobador ni catálogos Dataverse.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "name",
    "amountPen",
    "date",
    "categoryCode",
    "branchCode",
    "accountName",
    "flowClass"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 4,
      "maxLength": 100
    },
    "amountPen": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
      "maxLength": 16
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "categoryCode": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "branchCode": {
      "type": "string",
      "enum": [
        "LM",
        "SR"
      ]
    },
    "accountName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "flowClass": {
      "type": "string",
      "enum": [
        "operativo",
        "capital",
        "impuesto",
        "otro"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
