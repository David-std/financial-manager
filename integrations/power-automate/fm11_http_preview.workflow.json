{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 12,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "name": {
              "type": "string",
              "minLength": 4,
              "maxLength": 100
            },
            "amountPen": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
              "maxLength": 16
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "categoryCode": {
              "type": "string",
              "pattern": "^[0-9]{3}$"
            },
            "branchCode": {
              "type": "string",
              "enum": [
                "LM",
                "SR"
              ]
            },
            "accountName": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "flowClass": {
              "type": "string",
              "enum": [
                "operativo",
                "capital",
                "impuesto",
                "otro"
              ]
            },
            "description": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "requestId",
            "name",
            "amountPen",
            "date",
            "categoryCode",
            "branchCode",
            "accountName",
            "flowClass"
          ]
        }
      }
    }
  },
  "actions": {
    "DISABLED_NO_FINANCIAL_WRITES": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {},
      "inputs": {
        "statusCode": 503,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "status": "NOT_CONFIGURED",
          "message": "FM-11 direct intake is disabled pending authenticated deployment."
        }
      }
    }
  },
  "outputs": {}
}
